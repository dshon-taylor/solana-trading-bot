# Local placeholder env for autonomous Candle Carl runs
# These are safe defaults to avoid startup assertion during diagnostics.
# Replace with real secrets or ensure SOPS-managed values are loaded in production.
HELIUS_API_KEY=placeholder_missing_helius_api_key
KEYPAIR_PATH=/home/dshontaylor/.sops/keypair.json
# Provide KEYPAIR env for backward-compatible wallet loaders (path only, not private key material)
KEYPAIR=/home/dshontaylor/.sops/keypair.json
SOPS_WALLET_FILE=/home/dshontaylor/.sops/wallet.json
TELEGRAM_DISABLED=true

# Autonomous tuning overrides applied by Candle Carl run
# Lower log verbosity to reduce noise in telemetry and avoid frequent restarts
LOG_LEVEL=warn
# Increase playbook restart threshold to reduce noisy restart-triggered recoveries (was 12)
PLAYBOOK_RESTART_THRESHOLD=24
PLAYBOOK_RESTART_WINDOW_MS=1800000
