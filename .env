NODE_OPTIONS=--max-old-space-size=3072
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
TELEGRAM_DISABLED=true
# Wallet secret source (preferred)
# TELEGRAM_BOT_TOKEN removed by autonomous autotune to prevent unwanted external fetch attempts
TELEGRAM_BOT_TOKEN=DISABLED_PLACEHOLDER_TOKEN_AUTOTUNE_OK
TELEGRAM_CHAT_ID=6076361860
HELIUS_API_KEY=494b9cb1-4a51-42a0-84ff-dd924a7071b0
# Candidate sources
JUP_TOKENLIST_ENABLED=false
JUP_TOKENLIST_URL=https://cache.jup.ag/tokens
JUP_TOKENLIST_SAMPLE_N=40
JUP_PREFILTER_ENABLED=false
TG_VISIBILITY_PINGS=false
# Forward tracking ("what would have happened")
TRACK_ENABLED=false
TRACK_SAMPLE_EVERY_MS=120000
TRACK_HORIZON_HOURS=24
TRACK_MAX_ACTIVE=20
TRACK_CANDIDATES_PER_CYCLE=12
# Paper momentum trading
PAPER_ENABLED=false
# Entry rules
PAPER_ENTRY_RET_15M_PCT=0.02
PAPER_ENTRY_RET_5M_PCT=0.005
PAPER_ENTRY_GREEN_LAST5=3
PAPER_ENTRY_COOLDOWN_MS=900000
# Risk rules (paper only)
PAPER_STOP_LOSS_PCT=0.18
PAPER_STOP_AT_ENTRY=true
PAPER_STOP_AT_ENTRY_BUFFER_PCT=0.0005
PAPER_TRAIL_ACTIVATE_PCT=0.12
PAPER_TRAIL_DISTANCE_PCT=0.12
PAPER_BREAKEVEN_ON_TRAIL_ACTIVATE=false
# LIVE momentum strategy (go live)
LIVE_MOMO_ENABLED=false
LIVE_MOMO_USD_TARGET=1
LIVE_MOMO_USD_MIN=1
LIVE_MOMO_USD_MAX=1
LIVE_MOMO_SIZE_MODE=usd
LIVE_MOMO_PCT_OF_PORTFOLIO=0.10
LIVE_MOMO_MAX_SOL_PER_TRADE=1.0
LIVE_MOMO_STOP_AT_ENTRY=true
LIVE_MOMO_STOP_AT_ENTRY_BUFFER_PCT=0.005  # reduce stop-at-entry buffer to tighten entries (Candle Carl low-risk)
LIVE_STOP_ARM_DELAY_MS=120000
LIVE_PREARM_CATASTROPHIC_STOP_PCT=0.07
LIVE_MOMO_TRAIL_ACTIVATE_PCT=0.12
LIVE_MOMO_TRAIL_DISTANCE_PCT=0.12
# Filters: disable gates not used in this strategy version
REQUIRE_SOCIAL_META=false
AI_PIPELINE_ENABLED=false
MOMENTUM_FILTER_ENABLED=true
# Disable all eligibility gates not used in paper momentum sim
RUGCHECK_ENABLED=false
BASE_FILTERS_ENABLED=false
MCAP_FILTER_ENABLED=true
LIQ_RATIO_FILTER_ENABLED=false
# Ignore /halt + tradingEnabled=false; only balance should limit entries
FORCE_TRADING_ENABLED=true
MAX_POSITION_USDC=1.25
MAX_POSITIONS=3
PORTFOLIO_STOP_USDC=0
MAX_DRAWDOWN_PCT=1
MIN_SOL_FOR_FEES=0.06
# Disable scanner-based entries (DexScreener boosted scanner); use only paper momentum -> LIVE momo entries
SCANNER_ENTRIES_ENABLED=false
SCANNER_TRACKING_ENABLED=true
AUTO_TUNE_ENABLED=false
JUP_PREFILTER_AMOUNT_USD=5
JUPITER_API_KEY=d820916d-3a4b-485f-adce-7e201eb7fb98
SOLANA_RPC_URL=https://beta.helius-rpc.com/?api-key=494b9cb1-4a51-42a0-84ff-dd924a7071b0,https://mainnet.helius-rpc.com/?api-key=494b9cb1-4a51-420a-84ff-dd924a7071b0,https://api.mainnet.solana.com
SCAN_EVERY_MS=900000 # tuned by Candle Carl (increased to reduce RPC/snapshot frequency)
NO_PAIR_RETRY_ATTEMPTS=5
NO_PAIR_RETRY_BASE_MS=200
NO_PAIR_RETRY_MAX_BACKOFF_MS=2000
NO_PAIR_RETRY_TOTAL_BUDGET_MS=1500
NO_PAIR_TEMP_TTL_MS=35000
MARKETDATA_MIN_ENTRY_CONFIDENCE_SCORE=0.60
MARKETDATA_MAX_FRESHNESS_MS_FOR_ENTRY=20000
SKIP_MINT_ON_STALE_MS=300000
EXTRA_WATCHERS=FGyJVYwXDEMV34i3qzXvS6DXHCTEy4zLEp2jHn3byD6U
SOPS_WALLET_FILE=/home/dshontaylor/wallet-setup/secrets/wallet.enc

# Backwards-compatible alias expected by validation script
KEYPAIR_PATH=/home/dshontaylor/.config/solana/id.json

# Autotune placeholder (set real Birdseye API key in production)
BIRDEYE_API_KEY=DISABLED_PLACEHOLDER_AUTOTUNE_OK
# Backwards-compatible KEYPAIR (path to key file). Do NOT put private key material here.
KEYPAIR=/home/dshontaylor/.config/solana/id.json
SOPS_AGE_KEY_FILE=/home/dshontaylor/.config/sops/age/keys.txt

# Added by Candle Carl autonomous run: health endpoint for process monitoring
HEALTH_PORT=8787

LOG_LEVEL=warn
DATA_CAPTURE_ENABLED=true
OBSERVABILITY_ENABLED=false
EXECUTION_ENABLED=false
SIM_TRACKING_ENABLED=true
MIN_LIQUIDITY_FLOOR_USD=10000
MIN_MCAP_USD=200000
MIN_TOKEN_AGE_HOURS=0.025
LIQUIDITY_TO_MCAP_RATIO=0.01
PLAYBOOK_ENABLED=false

# --- Playbook tuning (autonomy) ---
# Increased restart sensitivity threshold to reduce noisy restarts under pm2 history.
PLAYBOOK_RESTART_THRESHOLD=60
PLAYBOOK_RESTART_WINDOW_MS=7200000

SOURCE_MODE=quality_first
SOURCE_QUALITY_JUP_SAMPLE_N=4
SOURCE_QUALITY_TRENDING_SAMPLE_N=4
SOURCE_QUALITY_REQUIRE_JUP_QUOTEABLE=true
TRENDING_ENABLED=true
TRENDING_REFRESH_MS=1800000 # increased to reduce trending sampling frequency
BIRDEYE_LITE_ENABLED=false
BIRDEYE_LITE_URL=
BIRDEYE_WS_ENABLED=false
BIRDEYE_LITE_MAX_RPS=0
BIRDEYE_LITE_CHAIN=solana
# Birdseye Lite CU/request throttle (per mint)
BIRDEYE_LITE_CACHE_TTL_MS=60000
BIRDEYE_LITE_PER_MINT_MIN_INTERVAL_MS=3600000
BIRDEYE_SUB_POLL_MS=120000
BIRDEYE_WS_MAX_SUBS=1  # reduced by Candle Carl autonomous run to lower websocket concurrency (low-risk)
BIRDEYE_WS_STALE_MS=800
WATCHLIST_EVAL_EVERY_MS=600000  # tuned by Candle Carl

# High-conversion live profile
AGGRESSIVE_MODE=false
EARLY_SHORTLIST_PREFILTER_MODE=minimal
AGGRESSIVE_EARLY_SHORTLIST_PREFILTER_MODE=minimal
MAX_NEW_ENTRIES_PER_HOUR=1

SOURCE_RPS=0.5 # reduced to lower RPC request rate
SHORTLIST_MIN_TX_1H=8

# Autotune additions: lower live candidate/probe fanout to reduce memory & event-loop load (low-risk)
LIVE_CANDIDATE_SHORTLIST_N=2
LIVE_PROBE_MAX_CANDIDATES=1

# Autotune fix (Candle Carl) - ensure backoff >= scan interval
SCAN_BACKOFF_MAX_MS=1200000
WATCHLIST_IMMEDIATE_ROUTE_MAX_PER_CYCLE=1

# --- Route cache tuning (applied by Candle Carl run) ---
# Increase TTL to reduce recomputation and RPC calls; keep max size to avoid eviction churn.
# Final chosen values after autonomous run.
ROUTE_CACHE_TTL_MS=600000
ROUTE_CACHE_MAX_SIZE=1024
CONFIRM_MAX_SNAPSHOT_AGE_MS=60000
